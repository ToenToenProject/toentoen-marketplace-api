# ==============================================================================
# ENVIRONMENT & GENERAL
# ==============================================================================
APP_ENV=production
PORT=3000

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Untuk Local Dev:
#   DB_HOST=localhost (atau postgres-db jika via docker compose)
#   DB_PORT=5432 (atau 5433 jika dipetakan)
#   DB_SSLMODE=disable
#
# Untuk AWS RDS Production:
#   DB_HOST=toentoen-db.xxxxxx.ap-southeast-2.rds.amazonaws.com
#   DB_PORT=5432
#   DB_SSLMODE=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=toentoen_app
DB_PASSWORD=YourSecureDatabasePasswordHere
DB_NAME=toentoendb
DB_SSLMODE=disable
ENABLE_AUTO_MIGRATE=false

# Connection Pool Settings (Skala Industri / RDS)
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=15
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_CONN_MAX_IDLE_TIME_MINUTES=5

# ==============================================================================
# REDIS CACHE
# ==============================================================================
# Local: 127.0.0.1:6379 atau redis-cache:6379
# AWS ElastiCache: toentoen-redis.xxxxxx.cache.amazonaws.com:6379
REDIS_HOST=redis-cache:6379

# ==============================================================================
# SEARCH ENGINE (MEILISEARCH)
# ==============================================================================
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=your_secure_meili_master_key_here

# ==============================================================================
# AUTH & SECURITY KEYS
# ==============================================================================
JWT_SECRET=your_super_secret_jwt_random_hash_64_characters_minimum
DATA_ENCRYPTION_KEY=d8f4c2e6b91a7350f4a8b2d1c9e7f5a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7
BLIND_INDEX_KEY=9e1c7a5b3f0d2e4a8b6c1d7f5e3a9b2c8d4e0f6a1b7c3d9e5f2a8b4c0d6e1f3a
REQUIRE_PHONE_VERIFICATION=false

# ==============================================================================
# GOOGLE OAUTH
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================================================================
# SMTP EMAIL CONFIGURATION
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=official.toentoen@gmail.com
SMTP_PASSWORD=your_app_password_here

# ==============================================================================
# AWS S3 STORAGE
# ==============================================================================
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=toentoen-storage-prod
